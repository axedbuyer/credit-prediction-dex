# matching-engine — env vars (read in src/main.ts, src/settler.ts)
# Copy to .env and fill in real values.
#
# SETLER_PRIVATE_KEY is a real secret (it signs on-chain settlement txs) — never commit
# a filled-in .env, only this .env.example template.

# --- Token / USDC addresses used by the in-memory matching config (src/main.ts) ---

# YES token address. Defaults to a placeholder (0x...0001) if unset.
YES_TOKEN_ADDRESS=

# NO token address. Defaults to a placeholder (0x...0002) if unset.
NO_TOKEN_ADDRESS=

# USDC token address. Defaults to Base Sepolia Circle USDC if unset.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# How often (ms) the engine polls the order-book-server for new orders. Defaults to 500.
POLL_INTERVAL_MS=500

# --- order-book-server client ---

# Base URL of order-book-server's REST API. Defaults to http://localhost:3001.
ORDER_BOOK_URL=http://localhost:3001

# --- On-chain settler (optional — REQUIRED together to wire the settler; without both,
# matches are logged only and NOT submitted on-chain) ---

# Private key of the wallet that submits CLOBSettlement.verifyAndSettle() txs. REQUIRED
# to enable on-chain settlement. SECRET — never commit a real value.
SETTLER_PRIVATE_KEY=

# RPC URL for the settler's viem clients. REQUIRED to enable on-chain settlement.
# Also used by createSettler() to pick the chain (baseSepolia).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Redis (used by the settler's RedisOrderRemover to prune orders after a deterministic
# revert — e.g. FundingShortfall/PositionFrozen — is decoded at gas-estimation time) ---

# Redis host. Defaults to localhost.
REDIS_HOST=localhost

# Redis port. Defaults to 6379.
REDIS_PORT=6379

# --- Settler contract addresses (src/settler.ts createSettler) ---
# Env vars take precedence; if any is unset, createSettler() falls back to reading
# contracts/deployments/base-sepolia.json (local dev only — the file does not exist
# inside containers, so set all of these explicitly in hosted environments).
# USDC_ADDRESS above is also used here.

# CLOBSettlement contract address (verifyAndSettle target).
CLOB_SETTLEMENT_ADDRESS=

# CreditMarket contract address (claimable/fundingDebt reads for revert pruning).
CREDIT_MARKET_ADDRESS=
