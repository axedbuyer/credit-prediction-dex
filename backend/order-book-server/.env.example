# order-book-server — env vars (read in src/main.ts, src/chain.ts)
# Copy to .env and fill in real values. Nothing here is a secret; this service
# never signs transactions (that's matching-engine/keepers).

# --- Contract addresses (optional — fall back to contracts/deployments/base-sepolia.json,
# then to hardcoded placeholders/zero-ish addresses in code) ---

# USDC token address. Defaults to Base Sepolia Circle USDC if unset.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# YES token address. Falls back to contracts/deployments/base-sepolia.json (yesToken),
# then to a placeholder (0x...0001) if that file is missing.
YES_TOKEN_ADDRESS=

# NO token address. Defaults to a placeholder (0x...0002) if unset.
NO_TOKEN_ADDRESS=

# CLOBSettlement contract address. Falls back to contracts/deployments/base-sepolia.json
# (clobSettlement), then to a placeholder (0x...0003) if that file is missing. REQUIRED
# (together with BASE_SEPOLIA_RPC_URL below) for the live on-chain fee rate (see
# "Trading fee" below) — without both, feeBps() is never read and FEE_BPS is used as-is.
CLOB_SETTLEMENT_ADDRESS=

# CreditMarket contract address. Falls back to contracts/deployments/base-sepolia.json
# (creditMarket) if unset. REQUIRED (together with BASE_SEPOLIA_RPC_URL below) for the
# on-chain freeze/funding pre-filter on POST /order — without both, that check is
# skipped entirely (fails open; the on-chain revert is the real backstop).
CREDIT_MARKET_ADDRESS=

# --- Chain ---

# Chain ID. Defaults to 84532 (Base Sepolia). Override to 31337 for a local anvil node.
CHAIN_ID=84532

# RPC URL used for the optional chain pre-filter (frozen/funding checks on POST /order).
# Optional: if unset, the chain reader is disabled and the pre-filter is skipped
# (on-chain contract checks still enforce the real rules).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Trading fee ---
#
# The live fee rate is now read from CLOBSettlement.feeBps() on-chain (src/feeSource.ts)
# whenever CLOB_SETTLEMENT_ADDRESS and BASE_SEPOLIA_RPC_URL are both configured — that
# on-chain value is the source of truth, refreshed every FEE_REFRESH_MS so an admin
# setFeeConfig change is picked up without a restart. FEE_BPS below becomes a FALLBACK
# ONLY: used when no chain is configured (local tests/demo), or when the initial chain
# read fails (RPC down at startup) — a later failed refresh keeps the last good chain
# value rather than falling back to this env var. If FEE_BPS is set AND differs from the
# resolved on-chain value, the chain value wins and a warning is logged at startup.

# Fee rate in bps of min(p, 1-p) x Q — FALLBACK only (see above). Drives the net-of-fee
# price basis for NO bids and the fee component of the YES-sell FundingShortfall
# pre-filter when the chain reader isn't available. Defaults to 50.
FEE_BPS=50

# How often (ms) to re-read feeBps() from CLOBSettlement on-chain. 0 disables the
# periodic refresh (the one-shot startup read still runs). Defaults to 60000 (60s).
FEE_REFRESH_MS=60000

# --- Server ---

# HTTP port the Fastify server listens on. Defaults to 3001.
PORT=3001

# Comma-separated allow-list of exact CORS origins, e.g.
# https://credit-prediction-dex.vercel.app,http://localhost:3000
# Unset, empty, or "*" keeps the default wildcard Access-Control-Allow-Origin: *
# (deploying without setting this var is a no-op).
CORS_ORIGINS=

# --- Rate limiting (POST /order + DELETE /order/:id only) ---

# Max requests per client IP per ORDER_RATE_LIMIT_WINDOW_MS, shared across
# BOTH POST /order and DELETE /order/:id (one bucket, not one each).
# GET /orderbook, GET /health, and OPTIONS preflight are NEVER rate-limited.
# Set to 0 to disable the limiter entirely (used by the local demo stack /
# tests, which post several orders back-to-back). Defaults to 60.
ORDER_RATE_LIMIT_MAX=60

# Rate limit window length in milliseconds. Defaults to 60000 (60s).
ORDER_RATE_LIMIT_WINDOW_MS=60000

# Fastify's trustProxy option — controls how request.ip (what the rate
# limiter keys on) is derived from X-Forwarded-For. Leave unset for local
# dev (no reverse proxy). On Railway set TRUST_PROXY=2 (measured 2026-09-26:
# two proxy hops — see docs/hosted-env-vars.md) so request.ip resolves to the
# real client IP from X-Forwarded-For rather than a Railway proxy IP, WITHOUT trusting
# a client-spoofed left-most entry (a hop count picks the entry exactly N
# hops in from the trusted proxy, immune to extra fake entries a client
# prepends). "true" is also accepted (trusts ALL hops, so the left-most
# X-Forwarded-For entry wins) but is spoofable by the client whenever
# there's a real proxy in front — prefer the explicit hop count.
# Unset/blank -> false (X-Forwarded-For ignored).
TRUST_PROXY=

# --- Redis (order book storage) ---

# Redis host. Defaults to localhost.
REDIS_HOST=localhost

# Redis port. Defaults to 6379.
REDIS_PORT=6379

# Full Redis connection URL (redis://:password@host:port). Takes precedence over
# REDIS_HOST/REDIS_PORT — required for managed Redis with auth (e.g. Railway: ${{Redis.REDIS_URL}}).
REDIS_URL=
