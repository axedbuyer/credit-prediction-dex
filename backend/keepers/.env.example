# keepers — env vars for both funding-keeper.ts and liquidation-keeper.ts.
# Copy to .env and fill in real values.
#
# KEEPER_PRIVATE_KEY is a real secret (funding-keeper signs accrueFunding/flagClaimable
# txs) — never commit a filled-in .env, only this .env.example template.
# liquidation-keeper.ts is read-only (GET /claimable) — it does not sign anything.

# --- Shared: chain connection ---

# RPC URL. REQUIRED by both funding-keeper.ts and liquidation-keeper.ts (each throws at
# startup if unset).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Chain ID. Defaults to 84532 (Base Sepolia). Override to 31337 for a local anvil node
# (both keepers build a custom `defineChain` when this doesn't match baseSepolia.id).
CHAIN_ID=84532

# --- Shared: contract addresses ---

# CreditMarket contract address. Falls back to contracts/deployments/base-sepolia.json
# (creditMarket) if unset. liquidation-keeper.ts throws at startup if it can resolve
# neither this var nor the deployments file.
CREDIT_MARKET_ADDRESS=

# YES token address. Only read by liquidation-keeper.ts (GET /claimable balances).
# Falls back to contracts/deployments/base-sepolia.json (yesToken) if unset; throws at
# startup if neither resolves.
YES_TOKEN_ADDRESS=

# --- Shared: monitoring scope ---

# Comma-separated list of YES holder addresses to monitor/poll. Defaults to an empty
# list if unset (nothing tracked).
TRACKED_HOLDERS=

# --- funding-keeper.ts only ---

# Private key of the wallet that signs accrueFunding()/flagClaimable() txs. REQUIRED —
# funding-keeper.ts throws at startup if unset. SECRET — never commit a real value.
KEEPER_PRIVATE_KEY=

# HTTP port for funding-keeper's health check server (GET /health). Defaults to 3002.
HEALTH_PORT=3002

# --- liquidation-keeper.ts only ---

# How often (ms) liquidation-keeper polls tracked holders for claimable positions.
# Defaults to 30000 (30s).
POLL_INTERVAL_MS=30000

# HTTP port for liquidation-keeper's server (GET /claimable). Defaults to 3003.
PORT=3003
