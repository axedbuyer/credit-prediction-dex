# keepers — env vars for funding-keeper.ts, liquidation-keeper.ts, and
# liquidator-bot.ts. Copy to .env and fill in real values.
#
# KEEPER_PRIVATE_KEY / LIQUIDATOR_PRIVATE_KEY are real secrets (funding-keeper
# signs accrueFunding/flagClaimable txs; liquidator-bot signs claim/approve
# txs) — never commit a filled-in .env, only this .env.example template.
# liquidation-keeper.ts is read-only (GET /claimable) — it does not sign anything.

# --- Shared: chain connection ---

# RPC URL. REQUIRED by both funding-keeper.ts and liquidation-keeper.ts (each throws at
# startup if unset).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Chain ID. Defaults to 84532 (Base Sepolia). Override to 31337 for a local anvil node
# (both keepers build a custom `defineChain` when this doesn't match baseSepolia.id).
CHAIN_ID=84532

# --- Shared: contract addresses ---

# CreditMarket contract address. Falls back to contracts/deployments/base-sepolia.json
# (creditMarket) if unset. liquidation-keeper.ts throws at startup if it can resolve
# neither this var nor the deployments file.
CREDIT_MARKET_ADDRESS=

# YES token address. Read by both keepers (holder discovery indexes its Transfer
# events; liquidation-keeper also reads balances). Falls back to
# contracts/deployments/base-sepolia.json (yesToken) if unset; throws at startup if
# neither resolves.
YES_TOKEN_ADDRESS=

# --- Shared: holder discovery (holder-index.ts) ---

# Keepers discover YES holders from the token's Transfer events (startup backfill +
# incremental sync each cycle) — no hand-maintained list needed.
# First block to scan = the YES token deploy block. REQUIRED (both keepers throw at
# startup if unset). Base Sepolia: 43766743. A fresh anvil: 0.
HOLDER_INDEX_FROM_BLOCK=43766743

# Blocks per eth_getLogs call (public Base RPC caps a call at a 1,000-block range)
# and calls in flight per batch. Defaults 1000 / 4. Raise with a paid RPC.
HOLDER_INDEX_CHUNK_SIZE=1000
HOLDER_INDEX_CONCURRENCY=4

# Optional. Persists discovery progress (cursor + holder set) so a restart resumes
# instead of re-backfilling — strongly recommended on Sepolia/mainnet, where a full
# backfill is thousands of eth_getLogs calls. Both keepers may share one Redis.
REDIS_URL=

# Optional extra seed addresses (comma-separated), always monitored in addition to
# discovered holders. No longer required — kept for back-compat and emergencies.
TRACKED_HOLDERS=

# --- funding-keeper.ts only ---

# Private key of the wallet that signs accrueFunding()/flagClaimable() txs. REQUIRED —
# funding-keeper.ts throws at startup if unset. SECRET — never commit a real value.
KEEPER_PRIVATE_KEY=

# HTTP port for funding-keeper's health check server (GET /health). Defaults to 3002.
HEALTH_PORT=3002

# --- liquidation-keeper.ts only ---

# How often (ms) liquidation-keeper polls tracked holders for claimable positions.
# Defaults to 30000 (30s).
POLL_INTERVAL_MS=30000

# HTTP port for liquidation-keeper's server (GET /claimable). Defaults to 3003.
PORT=3003

# Comma-separated allow-list of exact origins for CORS on GET /claimable and
# GET /health (e.g. "https://credit-prediction-dex.vercel.app,http://localhost:3000").
# Unset, empty, or "*" keeps the wildcard Access-Control-Allow-Origin: * default.
CORS_ORIGINS=

# --- liquidator-bot.ts only ---
#
# The liquidator of last resort: claims EVERY seizure-flagged Upbet (YES) position
# promptly (profitable or not — tail-case claims are break-even for the bot and let
# the InsuranceFund top up; stalls are what cost the fund), then hands whatever YES
# it accumulates to the CLOB via clob-seller.ts (ClobYesSeller).

# Private key of the wallet that signs claim()/approve() txs. REQUIRED — throws at
# startup if unset. SECRET — never commit a real value. This wallet needs a USDC
# float large enough to cover claim costs (P ≤ Q × currentMark / 1e18 per position;
# see the "ALERT insufficient USDC float" log line for sizing signals) and enough
# ETH for gas.
LIQUIDATOR_PRIVATE_KEY=

# Additional contract addresses beyond CREDIT_MARKET_ADDRESS/YES_TOKEN_ADDRESS above
# (which liquidator-bot.ts also reads). Each falls back to the matching key in
# contracts/deployments/base-sepolia.json if unset; throws at startup if neither
# resolves.
USDC_ADDRESS=
LIQUIDATION_ENGINE_ADDRESS=
INSURANCE_FUND_ADDRESS=
CLOB_SETTLEMENT_ADDRESS=

# How often (ms) the bot polls for claimable positions and re-lists any held YES.
# Defaults to 30000 (30s). Same variable name/semantics as liquidation-keeper's.
POLL_INTERVAL_MS=30000

# Whether the bot lists any YES it ends a cycle holding for sale via clob-seller.ts
# after the claim loop. Defaults to true; set to "false" to disable (e.g. the bot
# should only claim and hold, some other process handles selling).
AUTO_SELL=true

# HTTP port for liquidator-bot's health check server (GET /health). Internal-only —
# no public API. Defaults to 3004.
HEALTH_PORT=3004

# --- liquidator-bot.ts: clob-seller.ts (ClobYesSeller) wiring ---

# Base URL of order-book-server, used by clob-seller.ts to post/cancel the resting
# ask that lists the bot's claimed YES for sale. Defaults to http://localhost:3001.
ORDER_BOOK_URL=http://localhost:3001

# Optional tuning for clob-seller.ts's ask pricing/lifetime — see ClobYesSeller's
# constructor. Both optional; clob-seller.ts supplies its own defaults if unset.
SELL_MAX_DISCOUNT_BPS=
SELL_ORDER_TTL_SEC=

# --- Graceful shutdown (all three keepers) ---

# On SIGTERM/SIGINT (every Railway redeploy sends SIGTERM — each keeper is PID 1
# under its exec-form CMD `node -r ts-node/register`), the keeper stops scheduling
# new work, waits for any in-flight run/poll/cycle to finish (so a submitted
# accrueFunding/flagClaimable/claim/approve tx is never abandoned mid-flight),
# closes its HTTP server, and releases the holder index's Redis connection —
# bounded by this overall budget in ms. A second signal forces an immediate exit(1).
# Unset/blank/invalid/negative -> 25000 (25s).
SHUTDOWN_TIMEOUT_MS=25000
