# frontend — NEXT_PUBLIC_* env vars (read in lib/wagmi.ts, lib/contracts.ts,
# lib/constants.ts). Copy to .env.local and fill in real values.
#
# All NEXT_PUBLIC_* vars are inlined into the client bundle at build time and are
# NOT secret — do not put private keys here.

# --- Wallet / RPC (lib/wagmi.ts) ---

# WalletConnect Cloud project ID (https://cloud.walletconnect.com). REQUIRED in
# production — wagmi.ts throws at config creation if unset/empty when
# NODE_ENV=production. In development, falls back to 'placeholder' with a console.warn.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC URL used by wagmi's viem transport for Base Sepolia. Optional — if unset, wagmi's
# http() uses the chain's default public RPC.
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# --- Market discovery (lib/markets.ts) ---
# MarketRegistry contract address. When set, the site discovers every market on-chain
# (allMarkets()) and the per-market address vars below are IGNORED. When unset, the
# site runs in LEGACY mode: exactly one market `mstr`, built from the vars below.
NEXT_PUBLIC_MARKET_REGISTRY_ADDRESS=

# --- Legacy single-market contract addresses (lib/contracts.ts, read only by lib/markets.ts) — all optional, default to the zero
# address (0x000...000) except usdc, which defaults to Base Sepolia Circle USDC.
# Populate these after running the deploy scripts against Base Sepolia. ---

NEXT_PUBLIC_CREDIT_MARKET_ADDRESS=
NEXT_PUBLIC_YES_TOKEN_ADDRESS=
NEXT_PUBLIC_NO_TOKEN_ADDRESS=
NEXT_PUBLIC_CLOB_SETTLEMENT_ADDRESS=
NEXT_PUBLIC_ORACLE_ROUTER_ADDRESS=
NEXT_PUBLIC_LIQUIDATION_ENGINE_ADDRESS=

# USDC token address. Defaults to Base Sepolia Circle USDC if unset.
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- Trading fee (lib/feeMath.ts) ---

# Fee rate in bps of min(p, 1-p) x Q. FALLBACK ONLY — the app reads the live
# rate from CLOBSettlement.feeBps on-chain (lib/useFeeBps.ts) and prefers that
# whenever it's loaded; this value is used only while that read is loading or
# errors, and by scripts that don't read chain state. Keep it close to the
# on-chain value anyway so fallback previews aren't badly wrong. Defaults to 50.
NEXT_PUBLIC_FEE_BPS=50

# --- Backend service URLs (lib/constants.ts) ---

# order-book-server base URL (used to poll/submit orders). Defaults to
# http://localhost:3001.
NEXT_PUBLIC_ORDER_BOOK_URL=http://localhost:3001

# liquidation-keeper base URL (used by /liquidate to list claimable positions).
# Defaults to http://localhost:3003.
NEXT_PUBLIC_LIQUIDATION_KEEPER_URL=http://localhost:3003
